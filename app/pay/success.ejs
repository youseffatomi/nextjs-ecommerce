<!DOCTYPE html>
<html lang="fa">
  <%- include("./../../components/layout/head") %>
  <body>
    <%- include("./../../components/layout/header/index") %>
    <!--  -->
    <main class="min-h-screen">
      <div class="container">
        <div class="white-box">
          <div class="white-box-content pt-[130px]">
            <div class="blue-box">
              <div class="blue-box-content">
                <div class="white-box">
                  <div
                    class="white-box-content grid grid-cols-1 gap-5 pb-0 lg:grid-cols-6 lg:items-center xl:grid-cols-5"
                  >
                    <div class="lg:col-span-2 xl:col-span-2">
                      <div class="lg:py-10">
                        <div class="blue-box">
                          <div
                            class="blue-box-content grid grid-cols-1 gap-3 text-lg"
                          >
                            <div
                              class="flex items-center justify-between rounded-md bg-white px-3 py-3"
                            >
                              <span>وضعیت:</span>

                              <span class="flex items-center gap-2">
                                <img
                                  src="/assets/images/icons/tick-circle.svg"
                                  alt=""
                                />
                                <span>موفق</span>
                              </span>
                            </div>
                            <div
                              class="flex items-center justify-between rounded-md bg-white px-3 py-3"
                            >
                              <span>تراکنش:</span>

                              <span> #132452684 </span>
                            </div>
                            <div
                              class="flex items-center justify-between rounded-md bg-white px-3 py-3"
                            >
                              <span>مبلغ:</span>

                              <span>
                                <span> 120,000,000 </span>
                                <span> ریال </span>
                              </span>
                            </div>
                            <div
                              class="flex items-center justify-between rounded-md bg-white px-3 py-3"
                            >
                              <span>زمان:</span>

                              <span> 1400/10/19 تاریخ 19:20 ساعت </span>
                            </div>
                            <div
                              class="flex items-center justify-between rounded-md bg-white px-3 py-3"
                            >
                              <span>بابت:</span>

                              <span>
                                <span>سفارش</span>
                                <span> #224865</span>
                              </span>
                            </div>
                            <a
                              href="/"
                              class="btn-main bg-primary-dark btn-hover text-white"
                            >
                              بازگشت به پنل کاربری
                            </a>

                            <span class="block text-center">
                              بازگشت به پنل کلربری پس از 15 ثانیه
                            </span>
                          </div>
                        </div>
                      </div>
                    </div>

                    <div
                      class="grid place-items-end self-end lg:col-span-4 xl:col-span-3"
                    >
                      <img src="/assets/images/pay-success.svg" alt="" />
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>
    <!--  -->
    <%- include("./../../components/layout/footer.ejs") %>
