<!DOCTYPE html>
<html lang="fa">
  <%- include("./../components/layout/head") %>
  <body>
    <%- include("./../components/layout/header/index") %>
    <!--  -->
    <main class="min-h-screen">
      <div class="container">
        <div class="white-box">
          <div class="white-box-content pt-[130px]">
            <h1 class="text-4xl text-center my-10">انتخاب درگاه بانکی</h1>

            <form>
              <div
                class="select-pay flex flex-col gap-5 items-center flex-wrap md:justify-center md:flex-row"
              >
                <% [0,0].forEach(e=>{ %>
                <div
                  class="w-[250px] md:w-[120px] overflow-hidden select-pay-item cursor-pointer border-4 border-slate-100 border-solid rounded-lg"
                >
                  <img src="/assets/images/idpay.jpg" alt="" />
                  <input type="radio" name="pay" class="hidden" />
                </div>
                <div
                  class="w-[250px] md:w-[120px] overflow-hidden select-pay-item cursor-pointer border-4 border-slate-100 border-solid rounded-lg"
                >
                  <img
                    src="/assets/images/zarinpal.png"
                    class="w-full"
                    alt=""
                  />

                  <input type="radio" name="pay" class="hidden" />
                </div>

                <%}) %>
              </div>

              <div
                class="blue-box mx-auto text-center md:w-6/12 lg:w-4/12 xl:w-3/12 mt-10"
              >
                <div class="blue-box-content grid grid-rows-2 gap-5">
                  <span class="text-xl"> مبلغ پرداختی </span>
                  <span class="text-2xl">
                    <span> 30,100,415 </span>
                    <span>ریال</span>
                  </span>

                  <button
                    type="submit"
                    class="btn-main btn-hover bg-primary-main text-white"
                  >
                    پرداخت
                  </button>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
    </main>
    <!--  -->
    <%- include("./../components/layout/footer.ejs") %>
  </body>
</html>
