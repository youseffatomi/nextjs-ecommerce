<div class="blue-box-content">
  <div
    class="w-full flex flex-col justify-be md:flex-row md:justify-between gap-5"
  >
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
      <div class="flex items-center sm:justify-start justify-center gap-3">
        <img src="/assets/images/icons/filter.svg" />
        <span>فیلتر نمایش نظرات: </span>
      </div>
      <div>
        <select class="selectBox">
          <option value="1">همه</option>
          <option value="2">تست1</option>
          <option value="3">2تست</option>
          <option value="4">3تست</option>
          <option value="5">4تست</option>
        </select>
      </div>
    </div>
    <div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <button
            popup-open="question"
            class="popup-open w-full btn-small bg-primary-main text-white hover:bg-primary-light"
          >
            <img
              src="/assets/images/icons/message-question-white.svg"
              alt="x"
            />
            <span> ثبت پرسش </span>
          </button>

          <div popup-name="question" class="popup-content">
            <div class="popup-container">
              <div class="popup-content-box">
                <div class="sm:mb-2">
                  <button
                    popup-close="question"
                    class="p-2 rounded-bl-2xl bg-body"
                  >
                    <img src="/assets/images/icons/close-circle.svg" alt="x" />
                  </button>
                </div>

                <div class="white-box">
                  <div class="white-box-content">
                    <div class="blue-box">
                      <div class="blue-box-content">
                        <div
                          class="text-base mb-3 flex flex-col sm:flex-row items-center justify-between"
                        >
                          <span> متن سوال : </span>

                          <button class="btn-small" copy-target=".inp.question">
                            <img src="/assets/images/icons/copy.svg" alt="" />
                            <span>کپی متن در کلیپبورد</span>
                          </button>
                        </div>

                        <textarea
                          placeholder="سوال خودت رو بنویس..."
                          class="inp question"
                        >
                        </textarea>
                      </div>
                    </div>
                    <button
                      class="mt-3 btn-main btn-hover bg-primary-main text-white w-full"
                    >
                      ارسال پرسش
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div>
          <button
            popup-open="submit-comment"
            class="w-full btn-small bg-primary-main text-white hover:bg-primary-light"
          >
            <img src="/assets/images/icons/messages-3.svg" alt="" />
            <span> ثبت دیدگاه </span>
          </button>

          <%- include("./../box-send-comment",{name:"submit-comment"}) %>
        </div>
      </div>
    </div>
  </div>
</div>
