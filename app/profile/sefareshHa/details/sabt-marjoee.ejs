<!DOCTYPE html>
<html lang="fa">
  <%- include("./../../../../components/layout/head") %>
  <body>
    <%- include("./../../../../components/layout/header/index") %>
    <!--  -->
    <main class="min-h-screen">
      <div class="container">
        <div class="white-box">
          <div class="white-box-content pt-[130px]">
            <section
              class="grid grid-cols-1 md:grid-cols-3 xl:grid-cols-4 gap-5"
            >
              <%- include("./../../../../components/profile/sidebar") %>

              <article class="md:col-span-2 xl:col-span-3">
                <div class="mb-5">
                  <h2 class="text-lg">ثبت درخواست مرجوعی</h2>
                  <div class="profile-line-gradient"></div>
                </div>

                <div class="blue-box mb-5">
                  <div class="blue-box-content">
                    <div
                      class="flex flex-col lg:flex-row lg:items-center justify-between gap-5"
                    >
                      <a href="#" class="btn-main bg-white self-start">
                        <i
                          class="icon-arrow-left-2 text-sm text-primary-light rotate-180"
                        ></i>
                      </a>
                      <div class="btn-main bg-white">
                        <span>کد سفارش:</span>
                        <span class="text-primary-light">#238872497</span>
                      </div>
                    </div>

                    <% [0,0,0].forEach((e,index)=>{%>
                    <div
                      class="select-marjoee transition-all flex items-center gap-3 mt-5 pr-2 py-1 pl-1 rounded-lg"
                    >
                      <div>
                        <input type="checkbox" class="icheck" />
                      </div>
                      <div class="white-box">
                        <div class="white-box-content">
                          <div
                            class="grid grid-cols-1 xl:grid-cols-8 2xl:grid-cols-9 gap-3"
                          >
                            <div
                              class="xl:col-span-5 2xl:col-span-6 grid grid-cols-1 xl:grid-cols-7 gap-5 items-center"
                            >
                              <div>
                                <img
                                  src="/assets/images/11tpro-black-1.png"
                                  alt="x"
                                  class="w-[120px] mx-auto"
                                />
                              </div>
                              <div class="xl:col-span-6">
                                <h3
                                  class="whitespace-nowrap text-ellipsis overflow-hidden w-full"
                                >
                                  گوشی موبایل شیائومی 11t pro 5g ظرفیت 256 رم
                                  8گوشی موبایل شیائومی 11t pro 5g ظرفیت 256 رم
                                  8گوشی موبایل شیائومی 11t pro 5g ظرفیت 256 رم 8
                                  شیائومی 11t pro 5g ظرفیت 256 رم 8
                                </h3>
                                <div
                                  class="text-sm lg:text-lg grid grid-col-1 gap-3"
                                >
                                  <div
                                    class="flex items-stretch blue-box overflow-hidden w-full xl:w-[300px] mt-7"
                                  >
                                    <div
                                      class="bg-primary-light py-1 min-w-[80px] sm:min-w-[130px] grid place-items-center text-white"
                                    >
                                      رنگ
                                    </div>
                                    <div
                                      class="blue-box-content !py-0 px-3 h-[40px] grid place-items-center"
                                    >
                                      <div class="flex items-center gap-3">
                                        <button class="select-color-btn">
                                          <div
                                            style="
                                              background-color: rgb(6, 145, 29);
                                            "
                                          ></div>
                                          <div
                                            style="
                                              background-color: rgb(
                                                92,
                                                223,
                                                59
                                              );
                                            "
                                          ></div>
                                        </button>
                                        <span> آبی سلستیال </span>
                                      </div>
                                    </div>
                                  </div>
                                  <div
                                    class="flex items-stretch blue-box overflow-hidden w-full xl:w-[300px]"
                                  >
                                    <div
                                      class="bg-primary-light py-1 min-w-[80px] sm:min-w-[130px] grid place-items-center text-white"
                                    >
                                      تعداد
                                    </div>
                                    <div
                                      class="blue-box-content !py-0 px-3 h-[40px] grid place-items-center"
                                    >
                                      1 عدد
                                    </div>
                                  </div>
                                </div>
                              </div>
                            </div>

                            <div
                              class="text-sm xl:col-span-3 2xl:col-span-3 gap-2 xl:flex items-center justify-between xl:flex-col xl:justify-between"
                            >
                              <div
                                class="flex items-stretch blue-box overflow-hidden w-full"
                              >
                                <div
                                  class="bg-primary-light py-1 min-w-[80px] sm:min-w-[130px] grid place-items-center text-white"
                                >
                                  مبلغ مرجوعی:
                                </div>
                                <div
                                  class="blue-box-content !py-0 px-3 h-[40px] w-full grid place-items-center"
                                >
                                  <div class="w-full text-left">
                                    <span>تومان</span>
                                    <span> 13,900,000 </span>
                                  </div>
                                </div>
                              </div>

                              <div class="mt-5 xl:mt-0 self-end">
                                <div class="counter mr-auto bg-body rounded-lg">
                                  <button
                                    add
                                    class="btn-small text-primary-light"
                                  >
                                    <i class="icon-add-square"></i>
                                  </button>

                                  <input type="number" disabled value="1" />
                                  <span>عدد</span>
                                  <button
                                    remove
                                    class="btn-small text-primary-light"
                                  >
                                    <i class="icon-minus-black"></i>
                                  </button>
                                </div>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                    <%}) %>
                    <div
                      class="mt-5 flex flex-col md:flex-row md:items-center md:justify-end gap-5"
                    >
                      <a
                        href="#"
                        class="btn-main btn-hover bg-white md:min-w-[120px] hover:shadow-neomorphism-top-left"
                        >بازگشت</a
                      >
                      <button
                        class="btn-main btn-hover bg-primary-light text-white md:min-w-[120px] hover:shadow-neomorphism-top-left"
                      >
                        ادامه
                      </button>
                    </div>
                  </div>
                </div>

                <%- include("./../../../../components/pagination") %>
              </article>
            </section>
          </div>
        </div>
      </div>
    </main>
    <!--  -->
    <%- include("./../../../../components/layout/footer.ejs") %>
  </body>
</html>
