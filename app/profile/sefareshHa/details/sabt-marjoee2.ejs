                                  <p class="mb-2">
                                    <span> علت مرجوعی: </span>
                                    <span class="text-red-500">*</span>
                                  </p>
                                  <select
                                    class="selectBox w-[80%] sm:w-[75%] lg:w-[65%]"
                                  >
                                    <option value="1">زرین فناوران</option>
                                    <option value="1">زرین فناوران</option>
                                    <option value="1">زرین فناوران</option>
                                    <option value="1">زرین فناوران</option>
                                  </select>
                                </div>
                              </div>
                            </div>

                            <div
                              class="text-sm xl:col-span-3 2xl:col-span-3 gap-2 xl:flex items-center justify-between xl:flex-col xl:justify-between"
                            >
                              <div
                                class="flex items-stretch blue-box overflow-hidden w-full z-0 relative"
                              >
                                <div
                                  class="bg-primary-light py-1 min-w-[80px] sm:min-w-[130px] grid place-items-center text-white"
                                >
                                  مبلغ مرجوعی:
                                </div>
                                <div
                                  class="blue-box-content !py-0 px-3 h-[40px] w-full grid place-items-center"
                                >
                                  <div class="w-full text-left">
                                    <span>تومان</span>
                                    <span> 13,900,000 </span>
                                  </div>
                                </div>
                              </div>
                            </div>
                          </div>

                          <div
                            class="grid grid-cols-1 xl:grid-cols-2 gap-5 mt-10"
                          >
                            <div>
                              <p class="mb-2">
                                <span> توضیحات: </span>
                                <span class="text-red-500">*</span>
                              </p>

                              <textarea class="inp !min-h-[150px]"> </textarea>
                            </div>
                            <div>
                              <p class="mb-2">
                                <span> ارسال عکس از شرایط کنونی کالا </span>
                                <span class="text-red-500">*</span>
                              </p>

                              <%-
                              include("./../../../../components/select-image")
