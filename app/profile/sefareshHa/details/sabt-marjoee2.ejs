                        background-color: var(--primary-light) !important;
                      }
                    </style>
                    <% [0,0,0].forEach((e,index)=>{%>
                    <div class="flex items-center gap-3 mt-5">
                      <div class="white-box">
                        <div class="white-box-content">
                          <div
                            class="grid grid-cols-1 xl:grid-cols-8 2xl:grid-cols-9 gap-3"
                          >
                            <div
