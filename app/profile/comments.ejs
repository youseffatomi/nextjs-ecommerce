                        class="btn-main btn-tab-list w-full md:w-auto active"
                      >
                        در انتظار دیدگاه
                      </button>
                      <button
                        tab-item
                        tab-target="s2"
                        class="btn-main btn-tab-list w-full md:w-auto"
