                            >
                              <img
                                src="/assets/images/icons/personalcard.svg"
                                alt=""
                              />

                              <span class="text-white"> اطلاعات گیرنده </span>
                            </div>

                            <div class="blue-box ml-auto max-w-[250px] my-5">
                              <div class="px-3 py-2 flex items-center gap-3">
