<!DOCTYPE html>
<html lang="fa">
  <%- include("./../components/layout/head") %>
  <body>
    <%- include("./../components/layout/header/index") %>
    <!--  -->
    <main class="min-h-screen">
      <div class="container">
        <div class="white-box">
          <div class="white-box-content pt-[130px]">
            <div class="mb-5">
              <h2 class="text-lg">سبد خرید</h2>
              <div class="profile-line-gradient"></div>
            </div>

            <!-- ========= -->

            <div class="blue-box">
              <div
                class="blue-box-content grid grid-cols-1 md:grid-cols-5 xl:grid-cols-6 2xl:grid-cols-7 items-start gap-5"
              >
                <section
                  class="md:col-span-3 xl:col-span-4 2xl:col-span-5 flex flex-col gap-5"
                >
                  <% [0,0,0].forEach(e=>{%>
                  <div class="white-box">
                    <div
                      class="white-box-content flex items-center flex-col gap-5 xl:flex-row"
                    >
                      <div>
                        <img
                          src="/assets//images/11tpro-black-1.png"
                          class="max-w-[100px]"
                          alt="x"
                        />
                      </div>

                      <div class="flex flex-col gap-5 xl:flex-grow">
                        <h3>گوشی موبایل شیائومی 11t pro 5g ظرفیت 256 رم 8</h3>

                        <div class="flex items-center gap-2">
                          <img
                            src="/assets/images/color.png"
                            class="w-[30px]"
                            alt="x"
                          />

                          <span class="text-sm"> خاکستری کهکشانی </span>
                        </div>
                      </div>

                      <div
                        class="flex flex-col-reverse lg:flex-row-reverse lg:w-full xl:w-auto xl:flex-col justify-between items-end min-h-[150px] lg:min-h-[80px] xl:min-h-[150px]"
                      >
                        <div class="counter bg-body rounded-lg">
                          <button add="" class="btn-small text-primary-light">
                            <i class="icon-add-square"></i>
                          </button>

                          <input type="number" disabled="" value="2" max="2" />
                          <span>عدد</span>
                          <button
                            class="remove-btn btn-small text-primary-light !max-w-[50px]"
                          >
                            <img
                              src="/assets/images/icons/trash.svg"
                              class=""
                              alt=""
                            />
                          </button>
                        </div>

                        <div>
                          <del class="text-[#8d8d8d] block mb-3">
                            <span>14,200,000</span>
                            <span>ریال</span>
                          </del>
                          <span class="text-xl">
                            <span>14,200,000</span>
                            <span>ریال</span>
                          </span>
                        </div>
                      </div>
                    </div>
                  </div>
                  <%}) %>
                </section>
                <section
                  class="md:col-span-2 xl:col-span-2 2xl:col-span-2 flex flex-col gap-5"
                >
                  <div class="white-box">
                    <div class="white-box-content flex flex-col gap-7">
                      <p class="text-primary-main">
                        <span>مجموع امتیازات جمع آوری شده با این خرید :</span>
                        <span>50 امتیاز</span>
                      </p>

                      <div
                        class="flex items-center justify-between text-lg lg:text-lg"
                      >
                        <span>
                          <span>قیمت کالا ها</span>
                          <span>(4)</span>
                        </span>

                        <span>
                          <span>13,900,000</span>
                          <span>تومان</span>
                        </span>
                      </div>
                      <div
                        class="flex items-center justify-between text-red-500 text-lg lg:text-lg"
                      >
                        <span>
                          <span>مجموع تخفیفات</span>
                        </span>

                        <span>
                          <span>900,000</span>
                          <span>تومان</span>
                        </span>
                      </div>

                      <p class="text-sm text-[#a5a5a5]">
                        هزینه ارسال براساس آدرس، زمان تحویل، وزن و حجم مرسوله
                        شما محاسبه می‌شود
                      </p>

                      <button
                        popup-open="select-address"
                        class="btn-main btn-hover bg-primary-dark text-white w-full"
                      >
                        ادامه
                      </button>
                    </div>
                  </div>

                  <div class="white-box">
                    <div class="white-box-content">
                      <textarea
