                          class="btn-main btn-hover bg-primary-dark text-white mr-auto my-5"
                        >
                          <i class="icon-add-square"></i>

                          <span>افزودن آدرس</span>
                        </button>

                        <div class="scroll-box">
                          <div
                            class="scroll-box-content max-h-[300px] lg:max-h-[600px]"
                          >
                            <div class="flex flex-col gap-5 my-5">
                              <% [0,0].forEach(e=>{%>

                              <div class="blue-box">
                                <div
                                  class="blue-box-content flex flex-col gap-5"
                                >
                                  <div
                                    class="flex items-center justify-between"
                                  >
                                    <input
                                      type="radio"
                                      name="product"
                                      class="icheck"
                                    />

                                    <button>
                                      <img
                                        src="/assets/images/icons/edit-black.svg"
                                        alt="x"
                                      />
                                    </button>
                                  </div>

                                  <p class="text-middel">
                                    خ. ملاصدرا، کوچه ۹ ، ساختمان پویا ، طبقه ۳ ،
                                    واحد ۴
                                  </p>

                                  <div
                                    class="md:flex items-center justify-start gap-20"
                                  >
                                    <div
                                      class="text-[#5a5a5a] flex items-center gap-3 mb-3 mt-5"
                                    >
                                      <img
                                        src="/assets/images/icons/signpost.svg"
                                        alt="x"
                                      />
                                      <span>شیراز</span>
                                    </div>

                                    <div
                                      class="text-[#5a5a5a] flex items-center gap-3"
                                    >
                                      <img
                                        src="/assets/images/icons/sms-tracking.svg"
                                        alt="x"
                                      />
                                      <span>234345645645</span>
                                    </div>
                                  </div>
                                </div>
                              </div>

                              <% }) %>
                            </div>
                          </div>
                        </div>

                        <div
                          class="flex flex-col md:flex-row justify-between gap-5"
                        >
                          <button
                            popup-close="select-address"
                            popup-open="resiver-info"
                            class="btn-hover min-w-[150px] flex-grow btn-main bg-primary-dark text-white lg:col-span-2"
                          >
                            <img
                              src="/assets/images/icons/tick-square.svg"
                              alt="0"
                            />
                            <span> تایید آدرس</span>
                          </button>

                          <button
                            class="btn-main min-w-[150px] bg-body text-black"
                            popup-close="select-address"
                          >
                            <img
                              src="/assets/images/icons/undo-black.svg"
                              alt="0"
                            />
                            <span> بازگشت</span>
                          </button>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <!--  -->
              <%-
              include("./../components/profile/create-address",{name:"create-address"})
              %>
