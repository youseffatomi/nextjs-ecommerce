                                        <div class="flex items-center gap-2">
                                          <img
                                            src="/assets/images/color.png"
                                            class="w-[30px]"
                                            alt="x"
                                          />

                                          <span class="text-sm">
                                            خاکستری کهکشانی
                                          </span>
                                        </div>
                                      </div>

                                      <div>
                                        <span class="text-lg">
                                          <span>14,200,000</span>
                                          <span>ریال</span>
                                        </span>
                                      </div>
                                    </div>
                                  </div>
                                  <%}) %>
                                </section>
                              </div>
                            </div>
